# Anthropic API key — get one at https://platform.claude.com/
ANTHROPIC_API_KEY=sk-ant-...

# Twilio SMS channel (optional — without these, messages go to the outbox only)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_FROM_NUMBER=+15550102030
# TWILIO_VALIDATE=true   # enforce webhook signature validation in production
# TWILIO_WHATSAPP_FROM=whatsapp:+15550102030  # WhatsApp sender (sandbox or approved); without it WhatsApp sends fall back to SMS

# Google Calendar sync (optional — without these, bookings skip the calendar)
# GOOGLE_SERVICE_ACCOUNT_FILE=data/google-sa.json  # service-account JSON key (gitignored!)
# GOOGLE_CALENDAR_ID=owner@example.com             # calendar shared with the service account
# BUSINESS_TIMEZONE=America/New_York               # IANA tz for calendar times (default UTC)

# Optional overrides
# SECRETARY_DB_PATH=secretary.db
# SECRETARY_BUSINESS_FILE=data/business.json
